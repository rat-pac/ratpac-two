### track_simplify.mac
#
# Demonstrates per-step MC track output, including the quenched energy
# deposit stored on each MCTrackStep, and the "tracksimplify" processor,
# which thins tracks down by merging consecutive steps into buckets
# covering at least min_length of path or min_time of elapsed time before
# they are written out. This is a pure I/O-side transform: it runs after
# the simulation has produced full-detail tracks, and only reduces how
# much of that detail gets written to disk.

/glg4debug/glg4param omit_muon_processes 1.0
/glg4debug/glg4param omit_hadronic_processes 1.0

/rat/db/set DETECTOR experiment "Validation"
/rat/db/set DETECTOR geo_file "Validation/Valid.geo"

/tracking/storeTrajectory 1
/tracking/discardParticleTrajectory opticalphoton

/run/initialize

# Simplify tracks before they reach the output processor. min_length (mm)
# and min_time (ns) are the path length / elapsed time accumulated before
# consecutive steps are merged into one, so a step is kept at least every
# min_length of path or min_time of time, whichever comes first.
/rat/proc tracksimplify
/rat/procset min_length 1.0
/rat/procset min_time 0.05

/rat/proc count
/rat/procset update 10

/rat/proclast outntuple
/rat/procset include_tracking 1

# Central 2.5 MeV electrons
/generator/add combo gun:point:poisson
/generator/vtx/set e- 0.0 0.0 0.0 2.5
/generator/pos/set 0.0 0.0 0.0
/generator/rate/set 2.0

/run/beamOn 100
